# ============================================
# 家政上门服务系统 - 本地构建 Dockerfile
# 直接使用宿主机 Maven 编译好的 JAR（跳过 Docker 内编译，加速构建）
#
# 构建示例:
#   docker build --build-arg MODULE=homeservice-auth -t homeservice/auth:latest -f Dockerfile.local .
# ============================================

FROM eclipse-temurin:17-jre-alpine
ARG MODULE

# 安装运行时依赖
RUN apk add --no-cache curl tzdata fontconfig

# 设置时区
ENV TZ=Asia/Shanghai
ENV LANG=zh_CN.UTF-8

# 创建非 root 用户运行服务
RUN addgroup -g 1000 appgroup && \
    adduser -u 1000 -G appgroup -D appuser

# 复制预编译的 JAR（使用确切文件名避免 BuildKit glob 问题）
COPY ${MODULE}/target/${MODULE}-1.0.0.jar /app/app.jar

# 设置文件权限
RUN chown -R appuser:appgroup /app

# 切换到非 root 用户
USER appuser

# 工作目录
WORKDIR /app

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --retries=5 --start-period=90s \
    CMD curl -s -f http://localhost:${SERVER_PORT:-8080}/actuator/health || exit 1

# 启动命令
ENTRYPOINT ["sh", "-c", "java ${JAVA_OPTS:--Xms256m -Xmx512m} -jar /app/app.jar"]
